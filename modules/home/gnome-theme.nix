# GNOME theming from the shared GUI theme (my.guiTheme): libadwaita and GTK3
# colours, cursor, and a GNOME Shell theme generated by recolouring the
# installed gnome-shell's own stylesheet (loaded via the User Themes extension).
{
  config,
  lib,
  pkgs,
  ...
}: let
  themeName = config.my.guiTheme;
  guiTheme = config.my.guiThemeData;
  theme =
    guiTheme.gnome
    or (throw "GUI theme '${themeName}' has no GNOME variant (themes/gui/${themeName}/gnome.nix)");
  resolvePkg = path: builtins.foldl' (pkg: attr: pkg.${attr}) pkgs path;

  cssVars = lib.concatStringsSep "\n" (lib.mapAttrsToList (n: v: "  --${n}: ${v};") theme.adwaita);
  namedColors = lib.concatStringsSep "\n" (lib.mapAttrsToList (n: v: "@define-color ${n} ${v};") theme.gtk3);

  shellCss =
    pkgs.runCommand "gnome-shell-${themeName}.css" {
      nativeBuildInputs = [pkgs.glib pkgs.python3];
      ramp = builtins.toJSON theme.shell.greyRamp;
      passAsFile = ["ramp"];
    } ''
      gresource extract ${pkgs.gnome-shell}/share/gnome-shell/gnome-shell-theme.gresource \
        /org/gnome/shell/theme/gnome-shell-${theme.shell.base}.css > upstream.css
      python3 ${./gnome-shell-recolor.py} upstream.css "$rampPath" \
        '${theme.shell.accent}' '${theme.shell.accentFg}' > $out
    '';
in {
  imports = [./gui-theme.nix];

  home.packages = [pkgs.gnomeExtensions.user-themes];
  xdg.dataFile."themes/${themeName}/gnome-shell/gnome-shell.css".source = shellCss;

  dconf.settings = {
    "org/gnome/shell".enabled-extensions = ["user-theme@gnome-shell-extensions.gcampax.github.com"];
    "org/gnome/shell/extensions/user-theme".name = themeName;
    "org/gnome/desktop/interface".accent-color = "yellow";
    "org/gnome/desktop/background" = {
      picture-uri = "file://${config.my.wallpaper}";
      picture-uri-dark = "file://${config.my.wallpaper}";
      picture-options = "zoom";
    };
    "org/gnome/desktop/screensaver".picture-uri = "file://${config.my.wallpaper}";
  };

  gtk = {
    enable = true;
    colorScheme = theme.shell.base;
    theme = {
      inherit (guiTheme.gtk.gtk.theme) name;
      package = resolvePkg guiTheme.gtk.gtk.theme.package;
    };
    iconTheme = {
      inherit (guiTheme.gtk.gtk.iconTheme) name;
      package = resolvePkg guiTheme.gtk.gtk.iconTheme.package;
    };
    gtk3.extraCss = namedColors;
    # libadwaita ignores gtk-theme-name; colours come from the CSS variables.
    gtk4.theme = null;
    gtk4.extraCss = ''
      :root {
      ${cssVars}
      }
    '';
  };

  home.pointerCursor = {
    enable = true;
    gtk.enable = true;
    package = resolvePkg guiTheme.gtk.cursor.package;
    inherit (guiTheme.gtk.cursor) name size;
  };
}
