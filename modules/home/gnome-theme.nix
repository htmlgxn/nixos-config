# GNOME theming from the shared GUI theme (my.guiTheme): GTK colours and cursor
# (gtk-theme.nix), wallpaper, and a GNOME Shell theme generated by recolouring
# the installed gnome-shell's own stylesheet (loaded via the User Themes extension).
{
  config,
  pkgs,
  ...
}: let
  themeName = config.my.guiTheme;
  theme =
    config.my.guiThemeData.gnome
    or (throw "GUI theme '${themeName}' has no GNOME variant (themes/gui/${themeName}/gnome.nix)");

  shellCss =
    pkgs.runCommand "gnome-shell-${themeName}.css" {
      nativeBuildInputs = [pkgs.glib pkgs.python3];
      ramp = builtins.toJSON theme.shell.greyRamp;
      passAsFile = ["ramp"];
    } ''
      gresource extract ${pkgs.gnome-shell}/share/gnome-shell/gnome-shell-theme.gresource \
        /org/gnome/shell/theme/gnome-shell-${theme.shell.base}.css > upstream.css
      python3 ${./gnome-shell-recolor.py} upstream.css "$rampPath" \
        '${theme.shell.accent}' '${theme.shell.accentFg}' > $out
    '';
in {
  imports = [./gtk-theme.nix];

  home.packages = [pkgs.gnomeExtensions.user-themes];
  xdg.dataFile."themes/${themeName}/gnome-shell/gnome-shell.css".source = shellCss;

  dconf.settings = {
    "org/gnome/shell".enabled-extensions = ["user-theme@gnome-shell-extensions.gcampax.github.com"];
    "org/gnome/shell/extensions/user-theme".name = themeName;
    "org/gnome/desktop/interface".accent-color = "yellow";
    "org/gnome/desktop/background" = {
      picture-uri = "file://${config.my.wallpaper}";
      picture-uri-dark = "file://${config.my.wallpaper}";
      picture-options = "zoom";
    };
    "org/gnome/desktop/screensaver".picture-uri = "file://${config.my.wallpaper}";
  };
}
